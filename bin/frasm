#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * @file frasm
 * @brief Frasm command-line interface.
 *
 * Usage: php bin/frasm <command> [arguments] [--options]
 *        php bin/frasm list
 */

use Core\Console\Application;
use Core\Console\Output;
use Core\Container\Container;

if (PHP_SAPI !== 'cli') {
    exit(1);
}

// Files made by commands stay writable for the group of the web server (shared storage, e.g. a disk mounted with
// a fixed uid/gid, where the web server writes through the group).
umask(0002);

try {
    require dirname(__DIR__) . DIRECTORY_SEPARATOR . 'core' . DIRECTORY_SEPARATOR . 'bootstrap.php';
} catch (Throwable $e) {
    fwrite(STDERR, '✖ Bootstrap failed: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}

exit((new Application(Container::getInstance(), new Output()))->run($argv));
