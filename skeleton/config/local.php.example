<?php

declare(strict_types=1);

/**
 * Local (per-server) configuration overriding config/*.php.
 * Never commit this file: it contains secrets.
 */
return [
    'app' => [
        'debug' => false,
        'key'   => '__APP_KEY__',
    ],

    // Default connection (framework tables); further connections: see config/database.php
    'database' => [
        'connections' => [
            'mysql' => [
                'host'     => 'localhost',
                'database' => 'frasm',
                'username' => '',
                'password' => '',
            ],
        ],
    ],

    // Test databases of `make test` (connections without one are disabled during the tests), e.g.:
    // 'testing' => ['database' => ['connections' => [
    //     'mysql' => ['database' => 'test_app', 'username' => 'test_app', 'password' => '…'],
    // ]]],

    // Scheduler for #[Schedule] tasks: the installer adds/removes the cron entry accordingly
    'scheduler' => [
        'enabled' => __SCHEDULER_ENABLED__,
    ],

    // Installable web app: set a name and an icon, then run `php bin/frasm pwa:build`
    'pwa' => [
        'enabled' => __PWA_ENABLED__,
    ],

    'auth' => [
        'default_admin' => [
            'password' => '__ADMIN_PASSWORD__',
        ],
    ],
